# Copy to cluster/site.env (gitignored). cluster/run.sh sources it.
export DATA_ROOT=/scratch/$USER/agent-perf-proxies
export HF_HOME=/scratch/$USER/models
export HF_HUB_CACHE=/scratch/$USER/models/hub
export VLLM_CACHE_ROOT=/scratch/$USER/.cache/vllm
export SLURM_ACCOUNT=
export SLURM_PARTITION=gpu-h100
export SITE=                          # this cluster and user, e.g. kestrel-ssaigan; names this site's folder of shared runs
export RESULTS_REPO=ssaigan/lm-agents # Hugging Face dataset holding shared runs (traces/<SITE>/<run_id>) and item files (configs/)
export HF_TOKEN=                      # a token with write access to RESULTS_REPO
